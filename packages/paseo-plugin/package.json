{
  "name": "argos-paseo-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paseo plugin surface for Argos runs and gates",
  "exports": {
    ".": {
      "types": "./dist/shared/identity.d.ts",
      "import": "./dist/shared/identity.js"
    }
  },
  "files": [
    "dist",
    "server",
    "shared",
    "client",
    "index.server.ts",
    "index.client.tsx",
    "paseo-plugin.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.entry.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@getpaseo/client": "0.15.4",
    "@getpaseo/plugin": "0.15.4",
    "@thaodangspace/argos-core": "0.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "react": "19.3.0",
    "react-test-renderer": "19.3.0"
  }
}
