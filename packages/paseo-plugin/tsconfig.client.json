{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2023"],
    "types": ["node", "react"]
  },
  "include": [
    "index.client.tsx",
    "client/**/*.ts",
    "client/**/*.tsx",
    "shared/**/*.ts",
    "test/**/*.tsx"
  ],
  "exclude": []
}
