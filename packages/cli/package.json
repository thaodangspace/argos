{
  "name": "@thaodangspace/argos",
  "version": "0.1.0",
  "type": "module",
  "description": "Durable YAML playbook engine CLI for Paseo agents",
  "license": "MIT",
  "keywords": [
    "argos",
    "paseo",
    "playbook",
    "workflow",
    "orchestration",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaodangspace/argos.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/thaodangspace/argos#readme",
  "bugs": {
    "url": "https://github.com/thaodangspace/argos/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "argos": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "postbuild": "node scripts/make-bin-executable.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@thaodangspace/argos-core": "0.1.0"
  }
}
