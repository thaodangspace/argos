{
  "name": "argos-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Argos command-line client",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "argos": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "postbuild": "chmod +x dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "argos-core": "0.0.0"
  }
}
