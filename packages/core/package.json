{
  "name": "argos-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Argos playbook loader, engine, RPC server, and Paseo adapter",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    },
    "./playbook": {
      "types": "./dist/playbook/index.d.ts",
      "import": "./dist/playbook/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./durable": {
      "types": "./dist/durable/index.d.ts",
      "import": "./dist/durable/index.js"
    },
    "./paseo": {
      "types": "./dist/paseo/index.d.ts",
      "import": "./dist/paseo/index.js"
    },
    "./git": {
      "types": "./dist/git/index.d.ts",
      "import": "./dist/git/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "import": "./dist/rpc/index.js"
    },
    "./rpc/contracts": {
      "types": "./dist/rpc/contracts.d.ts",
      "import": "./dist/rpc/contracts.js"
    },
    "./rpc/server": {
      "types": "./dist/rpc/server.d.ts",
      "import": "./dist/rpc/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@getpaseo/client": "0.15.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
