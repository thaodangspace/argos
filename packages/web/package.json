{
  "name": "@thaodangspace/argos-web",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Argos workflow UI (SvelteKit SPA served by `argos serve` under /ui)",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "typecheck:tests": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@thaodangspace/argos-core": "0.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "5.0.6",
    "@skeletonlabs/skeleton-svelte": "5.0.6",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.3.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "31.0.1",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
